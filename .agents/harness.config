# .agents/harness.config — lu (sourcé) par verify-harness.sh et start-preview.sh
# Syntaxe shell : CLE="valeur", sans espaces autour du =

# Port de la preview QA et des tests Playwright (Expo : 4173, Next.js : 3000)
PREVIEW_PORT=4173

# Commande de preview personnalisée (laisser vide = détection auto Expo/Next)
PREVIEW_CMD=""

# "yes" = ne pas reconstruire si dist/ ou .next/ existe déjà
PREVIEW_SKIP_BUILD=""

# Étapes à sauter : renseigner une RAISON non vide pour sauter, sinon laisser vide.
# Une étape sautée apparaît comme SKIPPED (justifié) dans la preuve finale.
SKIP_TYPECHECK=""
SKIP_LINT=""
SKIP_UNIT=""
SKIP_BUILD=""
SKIP_E2E=""

# "yes" = ne pas lancer l'E2E si le build échoue
E2E_REQUIRES_BUILD="yes"

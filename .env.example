# ==============================================================================
# Variables d'environnement — Holidays
# ==============================================================================

# --- Client Supabase (Stack cible : Expo Web & Mobile) ---
# Publiques, incorporées au build si VERCEL=1 hors development.
# En local, le stockage navigateur reste autonome par défaut.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Serveur & Scripts PostgreSQL / Prisma (Stack cible) ---
# Ne jamais préfixer par EXPO_PUBLIC_.
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

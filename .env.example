# ==============================================================================
# Variables d'environnement pour le déploiement Vercel & Upstash Redis
# ==============================================================================

# --- Côté Serveur Vercel (Strictement confidentiel, configurer dans Vercel Dashboard) ---
# Ces variables sont lues par api/conges.ts et ne doivent JAMAIS être préfixées par EXPO_PUBLIC_
UPSTASH_REDIS_REST_URL="https://votre-base.upstash.io"
UPSTASH_REDIS_REST_TOKEN="votre_token_secret_upstash"

# --- Côté Client Expo (Application Mobile ou Dev Local connecté) ---
# En production Web sur Vercel : Cette variable n'est PAS nécessaire (le chemin relatif /api/conges est utilisé automatiquement).
# Pour l'application mobile (iOS / Android) ou pour tester en local avec la base distante :
# EXPO_PUBLIC_API_URL="https://votre-projet.vercel.app"
